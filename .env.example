EXPO_PUBLIC_SIGNING_SECRET=

# RevenueCat の公開 API キー
# TEST: Test Store のキー（開発ビルドのみ / test_ で始まる）
# 本番: App Store のキー（appl_ で始まる）
EXPO_PUBLIC_REVENUECAT_IOS_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# RevenueCat ダッシュボードの識別子（未設定ならコード側の既定値を使う）
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
EXPO_PUBLIC_REVENUECAT_MONTHLY_PACKAGE_ID=
EXPO_PUBLIC_REVENUECAT_YEARLY_PACKAGE_ID=

# 法的文書の URL（ペイウォールに表示。App Store 審査で必須）
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
